<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/q_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_glass"
    android:orientation="horizontal"
    android:padding="6dp">
        <LinearLayout
            android:id="@+id/q_morning"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:background="@drawable/widget_pill"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="6dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_sun" />

            <TextView
                android:id="@+id/q_morning_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="أذكار الصباح"
                android:textColor="#FFFFFFFF"
                android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/q_evening"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:background="@drawable/widget_pill"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="6dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_moon" />

            <TextView
                android:id="@+id/q_evening_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="أذكار المساء"
                android:textColor="#FFFFFFFF"
                android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/q_sleep"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:background="@drawable/widget_pill"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="6dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_bed" />

            <TextView
                android:id="@+id/q_sleep_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="أذكار النوم"
                android:textColor="#FFFFFFFF"
                android:textSize="11sp" />
        </LinearLayout>
</LinearLayout>
