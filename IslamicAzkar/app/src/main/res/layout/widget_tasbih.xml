<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/t_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_glass"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/t_phrase"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:maxLines="1"
            android:text="سُبْحَانَ اللَّهِ"
            android:textColor="#E6FFFFFF"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/t_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:text="0"
            android:textColor="#FFFFFFFF"
            android:textSize="38sp" />

        <TextView
            android:id="@+id/t_target"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="/ 33"
            android:textColor="#E6C676"
            android:textSize="12sp" />

        <ProgressBar
            android:id="@+id/t_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="5dp"
            android:layout_marginStart="10dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="10dp"
            android:max="33"
            android:progress="0"
            android:progressDrawable="@drawable/widget_progress" />
    </LinearLayout>

    <ImageView
        android:id="@+id/t_reset"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_gravity="top|end"
        android:background="@drawable/widget_pill"
        android:contentDescription="Reset"
        android:padding="6dp"
        android:src="@drawable/ic_reset" />
</FrameLayout>
