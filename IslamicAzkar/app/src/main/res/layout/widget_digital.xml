<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/d_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_glass"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="12dp">

    <TextClock
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.3"
        android:autoSizeMaxTextSize="64sp"
        android:autoSizeMinTextSize="24sp"
        android:autoSizeTextType="uniform"
        android:fontFamily="sans-serif-thin"
        android:format12Hour="h:mm"
        android:format24Hour="H:mm"
        android:gravity="center"
        android:includeFontPadding="false"
        android:textColor="#FFFFFFFF" />

    <ImageView android:id="@+id/d_date" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:scaleType="fitCenter" />
</LinearLayout>
