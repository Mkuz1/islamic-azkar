<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_glass"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@drawable/ic_star_gold" />

        <TextView
            android:id="@+id/w_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:text="ذكر اليوم"
            android:textColor="#D9FFFFFF"
            android:textSize="12sp" />

        <ImageView
            android:id="@+id/w_next"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/widget_pill"
            android:contentDescription="Next"
            android:padding="6dp"
            android:src="@drawable/ic_refresh" />
    </LinearLayout>

    <TextView
        android:id="@+id/w_arabic"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:autoSizeMaxTextSize="24sp"
        android:autoSizeMinTextSize="12sp"
        android:autoSizeTextType="uniform"
        android:fontFamily="serif"
        android:gravity="center"
        android:lineSpacingMultiplier="1.15"
        android:paddingTop="4dp"
        android:text="سُبْحَانَ اللَّهِ وَبِحَمْدِهِ"
        android:textColor="#FFFFFFFF"
        android:textDirection="rtl" />

    <TextView
        android:id="@+id/w_meaning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="2"
        android:text="Glory and praise be to Allah"
        android:textColor="#B3FFFFFF"
        android:textSize="12sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:letterSpacing="0.08"
        android:text="ISLAMIC AZKAR · أذكار إسلامية"
        android:textColor="#E6C676"
        android:textSize="10sp" />
</LinearLayout>
